# Copy to `.env` for local development. Never commit `.env`.
# On Render, set these in the service's Environment settings instead.

# AI provider: "mock" (offline canned responses, no key) or "gemini"
AI_PROVIDER=mock

# Required only when AI_PROVIDER=gemini
GEMINI_API_KEY=

# Default model for all AI endpoints (ignored by the mock provider)
AI_MODEL=

# Optional per-endpoint overrides (fall back to AI_MODEL)
PARSE_MODEL=
PLAN_MODEL=
CHAT_MODEL=
